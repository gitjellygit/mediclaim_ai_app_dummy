{
  "name": "claim-ai-backend",
  "type": "module",
  "scripts": {
    "dev": "npm run db:prepare:dev && node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "start:prepared": "npm run db:prepare && node src/index.js",
    "postinstall": "prisma generate",
    "db:prepare:dev": "node scripts/guardDevMigrations.js && npm run db:prepare",
    "seed:demo-uat": "node scripts/seed-demo-uat.js",
    "reset-lockout": "node scripts/reset-lockout.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/client-textract": "^3.1038.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "prettier": "3.8.1",
    "prisma": "^5.18.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "fast-xml-builder": "1.3.1"
  }
}
