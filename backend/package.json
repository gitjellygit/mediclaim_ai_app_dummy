{
  "name": "claim-ai-backend",
  "type": "module",
  "scripts": {
    "dev": "npm run db:prepare && node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "lint": "npx --yes eslint@9 .",
    "format:check": "npx --yes prettier@3 --check .",
    "format": "npx --yes prettier@3 --write .",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "start:prepared": "npm run db:prepare && node src/index.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/client-textract": "^3.1038.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "fast-xml-builder": "1.3.1"
  }
}
