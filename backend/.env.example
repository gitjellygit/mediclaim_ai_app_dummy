PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/claim_ai?schema=public
UPLOAD_DIR=uploads

# Replace with a unique secret of at least 32 characters. Never commit actual secrets.
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Set to your approved deployment region/bucket; no real patient data in local dev.
AWS_REGION=us-east-1
AWS_TEXTRACT_S3_BUCKET=


# Denial LLM integration is intentionally disabled by default.
# Do not set HIPAA_BAA_CONFIRMED=true for production PHI until your organization
# has the required BAA/healthcare agreement and has approved the deployment.
HIPAA_BAA_CONFIRMED=false
OPENAI_API_KEY=
OPENAI_DENIAL_MODEL=gpt-5.6-luna

# Enables synthetic Playwright fixture endpoints locally only.
# Never enable this in production.
E2E_TEST_MODE=false
