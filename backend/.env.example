PORT=4000
# Runtime hardening. Tune per deployment after observing normal traffic.
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
EXPENSIVE_RATE_LIMIT_WINDOW_MS=60000
EXPENSIVE_RATE_LIMIT_MAX=30
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://app:app@localhost:5432/claim_ai?schema=public
# npm run dev will refuse to auto-apply migrations to a non-local database
# unless this explicit emergency/development override is set.
ALLOW_NONLOCAL_DEV_MIGRATIONS=false
UPLOAD_DIR=uploads

# Document storage. Local is allowed only for development/test.
# Production startup requires DOCUMENT_STORAGE_BACKEND=s3.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
# Optional but recommended in production. When set, uploads use SSE-KMS;
# otherwise S3-managed AES256 server-side encryption is used.
DOCUMENT_S3_KMS_KEY_ID=

# Replace with a unique secret of at least 32 characters. Never commit actual secrets.
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Required in production when the browser frontend is hosted separately.
# Multiple origins may be comma-separated.
CORS_ORIGIN=http://localhost:5173

# Refresh credentials are stored in an HttpOnly cookie.
# Use "none" only for an approved cross-site deployment and keep Secure=true.
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false

# Local/demo seed credentials only. These are read only when a demo user is first
# created; the seed never overwrites an existing user's password.
DEV_ADMIN_PASSWORD=local-admin-change-me
DEV_CASHIER_PASSWORD=local-cashier-change-me
DEV_RECEPTION_PASSWORD=local-reception-change-me

# Set to your approved deployment region/bucket; no real patient data in local dev.
AWS_REGION=us-east-1
AWS_TEXTRACT_S3_BUCKET=

# Denial LLM integration is intentionally disabled by default.
# Do not set HIPAA_BAA_CONFIRMED=true for production PHI until your organization
# has the required BAA/healthcare agreement and has approved the deployment.
HIPAA_BAA_CONFIRMED=false
OPENAI_API_KEY=
OPENAI_DENIAL_MODEL=gpt-5.6-luna


# Epic FHIR backend integration.
# Sandbox uses Epic's public FHIR Developer Sandbox endpoints by default.
# Register a Backend Systems OAuth app in Epic on FHIR and configure its JKU.
# Never commit private keys. Newlines may be supplied as literal \n in env secrets.
EPIC_SANDBOX_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
EPIC_SANDBOX_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_JKU_URL=
EPIC_SANDBOX_JWK_KID=
EPIC_SANDBOX_PRIVATE_KEY=
# Synthetic/example patient only. Never use real PHI in Epic's public sandbox.
EPIC_SANDBOX_TEST_PATIENT_ID=

# Production uses the identical connector. Each Epic customer supplies its
# environment-specific endpoints and maps the production client ID + JKU.
EPIC_PRODUCTION_FHIR_BASE_URL=
EPIC_PRODUCTION_TOKEN_URL=
EPIC_PRODUCTION_CLIENT_ID=
EPIC_PRODUCTION_JKU_URL=
EPIC_PRODUCTION_JWK_KID=
EPIC_PRODUCTION_PRIVATE_KEY=
EPIC_PRODUCTION_TEST_PATIENT_ID=

# Payer connector selection. Existing LOCAL/SIMULATED behavior remains the
# default; external sandbox connectors are selected explicitly by ID.
PAYER_CONNECTOR_MODE=LOCAL
PAYER_CONNECTOR_ID=

# Release 1 sandbox connector credentials. Keep these empty until the matching
# sandbox account is provisioned. Never commit real credentials.
AVAILITY_API_BASE_URL=
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
# R2C demo uses explicit sandbox OAuth + eligibility endpoints so no
# production Availity URL is implied by the sample configuration.
AVAILITY_TOKEN_URL=
AVAILITY_ELIGIBILITY_URL=

OPTUM_API_BASE_URL=
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=

# Stedi test mode. Generate a Test API key in the Stedi portal.
# The eligibility endpoint uses the 2026-06-01 JSON response shape.
STEDI_TEST_API_KEY=
STEDI_API_BASE_URL=https://healthcare.us.stedi.com/2026-06-01
STEDI_PAYER_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
STEDI_CLAIMS_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# R4: poll inbound transactions and retrieve JSON 835 ERA reports.
STEDI_CORE_API_BASE_URL=https://core.us.stedi.com/2023-08-01
STEDI_ERA_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01

# R3 production Stedi connector.
# Keep production credentials blank until the approved environment is provisioned.
# Safety interlock: production Stedi remains disabled unless PHI transmission
# has been explicitly approved for this deployment. This flag is not itself
# proof of a BAA or HIPAA compliance.
STEDI_PRODUCTION_PHI_CONFIRMED=false
# Independent kill switch for real 837 transmission. Eligibility/status/ERA
# can remain enabled while production claim submission is disabled.
STEDI_PRODUCTION_SUBMISSION_ENABLED=false
# Institutional 837I remains separately disabled until its richer institutional
# mapping has completed production validation. Professional 837P can be enabled
# without enabling 837I.
STEDI_PRODUCTION_837I_ENABLED=false
# Keep production 835/ERA discovery disabled until deployment architecture
# guarantees organization isolation for Stedi transactions/credentials.
STEDI_PRODUCTION_ERA_TENANT_ISOLATION_CONFIRMED=false
# Bind the production ERA account/credential to exactly one CLAIM APP
# organization. ERA retrieval is unavailable unless the claim organization
# matches this value.
STEDI_PRODUCTION_ERA_ORGANIZATION_ID=
STEDI_PRODUCTION_API_KEY=
STEDI_PRODUCTION_API_BASE_URL=https://healthcare.us.stedi.com/2026-06-01
STEDI_PRODUCTION_CLAIMS_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# Optional override. Defaults to Stedi's production real-time claim-status endpoint.
STEDI_CLAIM_STATUS_URL=

# Atomic claim-submission ownership timeout. A claim left in SUBMITTING longer
# than this can be safely reclaimed on retry using the same stable patient
# control number / payer idempotency identity. Default: 15 minutes.
CLAIM_SUBMISSION_LOCK_TIMEOUT_MS=900000

# 837 submitter, billing-provider, legal indicators and optional POS defaults
# are stored per Organization in the database and managed through the
# authenticated admin submission-profile endpoint.

# Enables synthetic Playwright fixture endpoints locally only.
# Never enable this in production.
E2E_TEST_MODE=false

# Oracle Health / Cerner Millennium FHIR integration.
# The open sandbox is read-only and intentionally requires no authentication.
ORACLE_HEALTH_SANDBOX_FHIR_BASE_URL=https://fhir-open.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
ORACLE_HEALTH_SANDBOX_TEST_PATIENT_ID=12724067
ORACLE_HEALTH_PRODUCTION_FHIR_BASE_URL=
ORACLE_HEALTH_PRODUCTION_TEST_PATIENT_ID=
