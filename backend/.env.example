PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/claim_ai?schema=public
UPLOAD_DIR=uploads

# Document storage. Local is allowed only for development/test.
# Production startup requires DOCUMENT_STORAGE_BACKEND=s3.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
# Optional but recommended in production. When set, uploads use SSE-KMS;
# otherwise S3-managed AES256 server-side encryption is used.
DOCUMENT_S3_KMS_KEY_ID=

# Replace with a unique secret of at least 32 characters. Never commit actual secrets.
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Required in production when the browser frontend is hosted separately.
# Multiple origins may be comma-separated.
CORS_ORIGIN=http://localhost:5173

# Refresh credentials are stored in an HttpOnly cookie.
# Use "none" only for an approved cross-site deployment and keep Secure=true.
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false

# Local/demo seed credentials only. These are read only when a demo user is first
# created; the seed never overwrites an existing user's password.
DEV_ADMIN_PASSWORD=local-admin-change-me
DEV_CASHIER_PASSWORD=local-cashier-change-me
DEV_RECEPTION_PASSWORD=local-reception-change-me

# Set to your approved deployment region/bucket; no real patient data in local dev.
AWS_REGION=us-east-1
AWS_TEXTRACT_S3_BUCKET=

# Denial LLM integration is intentionally disabled by default.
# Do not set HIPAA_BAA_CONFIRMED=true for production PHI until your organization
# has the required BAA/healthcare agreement and has approved the deployment.
HIPAA_BAA_CONFIRMED=false
OPENAI_API_KEY=
OPENAI_DENIAL_MODEL=gpt-5.6-luna

# Payer connector selection. Existing LOCAL/SIMULATED behavior remains the
# default; external sandbox connectors are selected explicitly by ID.
PAYER_CONNECTOR_MODE=LOCAL
PAYER_CONNECTOR_ID=

# Release 1 sandbox connector credentials. Keep these empty until the matching
# sandbox account is provisioned. Never commit real credentials.
AVAILITY_API_BASE_URL=
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
# R2C demo uses explicit sandbox OAuth + eligibility endpoints so no
# production Availity URL is implied by the sample configuration.
AVAILITY_TOKEN_URL=
AVAILITY_ELIGIBILITY_URL=

OPTUM_API_BASE_URL=
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=

# Stedi test mode. Generate a Test API key in the Stedi portal.
# The eligibility endpoint uses the 2026-06-01 JSON response shape.
STEDI_TEST_API_KEY=
STEDI_API_BASE_URL=https://healthcare.us.stedi.com/2026-06-01
STEDI_PAYER_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
STEDI_CLAIMS_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# R4: poll inbound transactions and retrieve JSON 835 ERA reports.
STEDI_CORE_API_BASE_URL=https://core.us.stedi.com/2023-08-01
STEDI_ERA_API_BASE_URL=https://healthcare.us.stedi.com/2024-04-01

# R3 production Stedi connector.
# Keep production credentials blank until the approved environment is provisioned.
STEDI_PRODUCTION_API_KEY=
STEDI_PRODUCTION_API_BASE_URL=https://healthcare.us.stedi.com/2026-06-01
STEDI_CLAIM_STATUS_URL=

# Enables synthetic Playwright fixture endpoints locally only.
# Never enable this in production.
E2E_TEST_MODE=false
