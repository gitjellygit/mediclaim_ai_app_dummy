generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdmissionType {
  PLANNED
  EMERGENCY
}

enum ClaimType {
  PROVIDER_BILLED
  MEMBER_REIMBURSEMENT
}

enum ClaimForm {
  PROFESSIONAL
  INSTITUTIONAL
}

enum ClaimStage {
  INITIAL
  ENHANCEMENT
  FINAL
}

enum SubscriberRelationship {
  SELF
  SPOUSE
  CHILD
  OTHER
}

enum CoordinationOfBenefits {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum ClaimFrequencyCode {
  ORIGINAL
  INTERIM_FIRST
  INTERIM_CONTINUING
  INTERIM_LAST
  CORRECTED
  VOID
  FINAL_HOME_HEALTH
}

enum RoomCategory {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
}

enum UserRole {
  ADMIN
  CLAIMS_MANAGER
  CLAIMS_SPECIALIST
  DENIAL_SPECIALIST
  PRIOR_AUTH_SPECIALIST
  ACCOUNTANT
  CLINICAL_REVIEWER
  RECEPTIONIST
  AUDITOR
  PROVIDER
  CASHIER
}

enum ClaimStatus {
  DRAFT
  NEEDS_REVIEW
  READY
  SUBMITTING
  SUBMITTED
  DENIED
  PAID
}

enum EligibilityStatus {
  NOT_CHECKED
  VERIFIED
  NEEDS_REVIEW
  FAILED
}

enum PriorAuthStatus {
  NOT_CHECKED
  NEEDS_REVIEW
  NOT_REQUIRED
  REQUIRED
  APPROVED
  DENIED
}

enum PayerClaimStatus {
  SUBMITTED
  ACKNOWLEDGED
  RECEIVED
  IN_REVIEW
  PENDED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  DENIED
  PAID
}

enum RemittanceStatus {
  NOT_AVAILABLE
  AWAITING
  RECEIVED
  POSTED
}

enum PayerConnectionMode {
  LOCAL
  SIMULATED
  LIVE
}

enum DocumentType {
  DISCHARGE_SUMMARY
  FINAL_BILL
  BREAKUP_BILL
  LAB_REPORT
  RADIOLOGY
  PRESCRIPTION
  ID_PROOF
  INSURANCE_CARD
  PRIOR_AUTHORIZATION
  OPERATIVE_NOTE
  PROGRESS_NOTE
  EOB
  OTHER
}

enum DocumentStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CodingSystem {
  ICD10_CM
  CPT
  HCPCS
  ICD10_PCS
}

enum CodingSuggestionStatus {
  PENDING
  ACCEPTED
  CHANGED
  REJECTED
}


enum DenialCaseStatus {
  OPEN
  ANALYZED
  CORRECTION_REQUIRED
  APPEAL_PREPARED
  APPEAL_SUBMITTED
  RESUBMITTED
  OVERTURNED
  UPHELD
  CLOSED
}

enum DenialCaseSource {
  MANUAL
  PAYER_STATUS
  SIMULATED_PAYER_STATUS
  ERA
}

enum UnderpaymentCaseStatus {
  OPEN
  REVIEWING
  DISPUTE_PREPARED
  DISPUTE_SUBMITTED
  RECOVERED
  WRITTEN_OFF
  CLOSED
}

model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  slug      String   @unique

  // Monotonically increases whenever an active readiness rule changes.
  // Readiness checks store the revision they were evaluated against.
  rulesetRevision Int @default(1)

  // Organization-owned 837 submitter/billing/legal configuration.
  // Nullable by design: production submission fails preflight until configured.
  stediSubmitterName                         String?
  stediSubmitterId                           String?
  stediSubmitterPhone                        String?
  stediBillingProviderName                   String?
  stediBillingAddress1                       String?
  stediBillingAddress2                       String?
  stediBillingCity                           String?
  stediBillingState                          String?
  stediBillingPostalCode                     String?
  stediProfessionalSignatureIndicator        String?
  stediProfessionalPlanParticipationCode     String?
  stediInstitutionalPlanParticipationCode    String?
  stediBenefitsAssignmentIndicator           String?
  stediReleaseInformationCode                String?
  stediDefaultProfessionalPlaceOfService     String?
  stediDefaultInstitutionalPlaceOfService    String?

  users       User[]
  claims      Claim[]
  auditEvents AuditEvent[]
  rules       Rule[]
  ruleVersions RuleVersion[]
  integrationConnections IntegrationConnection[]
  integrationEvents IntegrationEvent[]
  claimExternalIdentities ClaimExternalIdentity[]
  priorAuthCases PriorAuthCase[]
  payerContracts PayerContract[]
  ruleRecommendations RuleRecommendation[]
  teams Team[]
  savedQueues SavedQueue[]
  claimComments ClaimComment[]
  clinicalRequests ClinicalRequest[]
  notifications Notification[]
  approvalRequests ApprovalRequest[]
  ownershipHistory ClaimOwnershipHistory[]
}

model Claim {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  deletedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User? @relation("ClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Operational work-management ownership. These fields are organization-scoped
  // and do not change payer/claim lifecycle state.
  assignedToUserId String?
  assignedToUser   User? @relation("ClaimAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  workTeam         String?
  workDueAt        DateTime?
  nextFollowUpAt   DateTime?
  lastWorkedAt     DateTime?
  escalatedAt      DateTime?
  managerPriority  String?
  managerPriorityReason String?
  holdReason       String?
  holdUntil        DateTime?

  patientName String
  payerName   String
  policyNo    String?
  amount      Decimal? @db.Decimal(14,2)
  status      ClaimStatus @default(DRAFT)

  patientAge    Int?
  patientGender Gender?
  patientDob    DateTime? @db.Date
  patientAddress1 String?
  patientAddress2 String?
  patientCity String?
  patientState String?
  patientPostalCode String?
  medicalRecordNumber String?
  patientMobile String?
  memberId      String?

  hospitalName    String?
  hospitalAddress String?
  hospitalRegNo   String?
  doctorName      String?
  doctorRegNo     String?

  // U.S. provider identifiers.
  billingProviderNpi   String?
  renderingProviderNpi String?
  referringProviderNpi String?
  providerTin          String?
  providerTaxonomyCode String?

  admissionDate DateTime? @db.Date
  dischargeDate DateTime? @db.Date
  admissionType AdmissionType?
  diagnosisText String?
  icd10Codes    String[]       @default([])
  procedureText String?
  procedureDate DateTime? @db.Date
  dateOfService DateTime? @db.Date
  inpatientProcedureCodes String[] @default([])

  planAdministratorName String?
  policyStartDate   DateTime? @db.Date
  policyEndDate     DateTime? @db.Date
  productType       String?
  coverageLimit      Decimal? @db.Decimal(14,2)
  remainingCoverageLimit Decimal? @db.Decimal(14,2)

  // U.S. coverage and subscriber information.
  groupNumber              String?
  subscriberId             String?
  subscriberName           String?
  subscriberDob            DateTime? @db.Date
  subscriberGender         Gender?
  subscriberAddress1       String?
  subscriberAddress2       String?
  subscriberCity           String?
  subscriberState          String?
  subscriberPostalCode     String?
  subscriberRelationship   SubscriberRelationship?
  coordinationOfBenefits   CoordinationOfBenefits?
  payerEdiId               String?

  claimType         ClaimType     @default(MEMBER_REIMBURSEMENT)
  claimForm         ClaimForm?
  claimStage        ClaimStage    @default(INITIAL)
  totalBilledAmount Decimal? @db.Decimal(14,2)
  approvedAmount    Decimal? @db.Decimal(14,2)
  deductionAmount   Decimal? @db.Decimal(14,2)
  copayAmount       Decimal? @db.Decimal(14,2)
  roomCategory      RoomCategory?
  icuDays           Int?

  // Institutional / claim-level U.S. billing metadata.
  typeOfBill             String?
  drgCode                String?
  claimFilingCode        String?
  admissionTypeCode      String?
  admissionSourceCode    String?
  patientStatusCode      String?
  claimFrequencyCode     ClaimFrequencyCode @default(ORIGINAL)
  timelyFilingDeadline   DateTime? @db.Date

  // Provider-assigned claim control number (837 CLM01 / CMS-1500 Box 26).
  // This is the primary correlation key for 277CA and 835 responses.
  patientControlNumber String?
  // Durable submission ownership. SUBMITTING is acquired atomically before any
  // outbound 837 and can only be reclaimed after the configured stale timeout.
  submissionAttemptId  String?
  submissionStartedAt  DateTime?
  submissionReconciliationRequired Boolean @default(false)
  submissionReconciliationReason   String?
  payerReferenceNo     String?
  insurerClaimNo       String?
  authorizationNo     String?
  claimSubmissionDate DateTime?

  // Revenue-cycle journey: eligibility -> prior auth -> claim -> status -> remittance.
  // These fields are deliberately explicit so each stage can be audited and gated.
  eligibilityStatus       EligibilityStatus @default(NOT_CHECKED)
  eligibilityCheckedAt    DateTime?
  coverageStatus          String?
  deductibleRemaining     Decimal? @db.Decimal(14,2)
  coinsurancePct          Int?
  networkStatus           String?

  priorAuthRequired       Boolean?
  priorAuthStatus         PriorAuthStatus @default(NOT_CHECKED)
  priorAuthCheckedAt      DateTime?
  priorAuthExpiry         DateTime?

  payerClaimStatus        PayerClaimStatus?
  claimStatusCheckedAt    DateTime?

  remittanceStatus        RemittanceStatus @default(NOT_AVAILABLE)
  remittanceReceivedAt    DateTime?
  allowedAmount           Decimal? @db.Decimal(14,2)
  patientResponsibility   Decimal? @db.Decimal(14,2)
  paidAmount              Decimal? @db.Decimal(14,2)
  paymentReference        String?

  // Connector abstraction: LOCAL today, SIMULATED for demo/testing, LIVE for
  // future clearinghouse/payer integrations. Simulated payer codes are synthetic.
  payerConnectionMode PayerConnectionMode @default(LOCAL)
  payerConnectorId    String?
  simulatedPayerCode  String?

  // The connected payer is workflow state. It must not overwrite the
  // insurance identity captured from documents/registration.
  connectedPayerCode  String?
  connectedPayerName  String?

  // Fields currently supported by uploaded documents. This lets document
  // deletion recompute/clear only document-derived data without wiping
  // values a user entered manually.
  documentDerivedFields String[] @default([])

  // Per-field source metadata used to show what was auto-populated, manually
  // entered, calculated, or received from an external transaction.
  // Example: { "amount": { "source": "DOCUMENT_AI", "confidence": 92, ... } }
  fieldProvenance Json?

  documents   Document[]
  serviceLines ServiceLine[]
  checks      Check[]
  denialCases DenialCase[]
  underpaymentCase UnderpaymentCase?
  auditEvents AuditEvent[]
  payerTransactions PayerTransaction[]
  codingSuggestions CodingSuggestion[]
  externalIdentities ClaimExternalIdentity[]
  integrationEvents IntegrationEvent[]
  priorAuthCase PriorAuthCase?
  comments ClaimComment[]
  clinicalRequests ClinicalRequest[]
  approvalRequests ApprovalRequest[]
  ownershipHistory ClaimOwnershipHistory[]

  @@index([organizationId, deletedAt, createdAt])
  @@index([createdById])
  @@index([assignedToUserId])
  @@index([organizationId, workDueAt])
  @@index([organizationId, nextFollowUpAt])
  @@index([payerConnectorId])
  @@index([organizationId, status, submissionStartedAt])
}

model ServiceLine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  cptHcpcsCode      String
  modifiers         String[] @default([])
  units             Decimal? @db.Decimal(10,2)
  charge            Decimal? @db.Decimal(14,2)
  diagnosisPointers String[] @default([])
  placeOfService    String?
  serviceDateFrom   DateTime? @db.Date
  serviceDateTo     DateTime? @db.Date
  revenueCode       String?
  poaIndicator      String?

  // OCR-created lines are suggestions until a billing user confirms them.
  verified          Boolean @default(true)
  source            String  @default("USER")
  sourceDocumentId  String?

  @@index([claimId])
  @@index([cptHcpcsCode])
}

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  type      DocumentType
  fileName  String
  mimeType  String
  sizeBytes Int
  path      String

  fileHash    String?
  rawText     String?
  ocrProvider String?

  isMandatory Boolean @default(false)
  verified    Boolean @default(false)

  // ✅ Document Intelligence (AI)
  suggestedType String?
  confidence    Int? // 0..100
  extracted     Json? // { patientName?, amount?, dates?, ... }
  status        DocumentStatus @default(PENDING)

  codingSuggestions CodingSuggestion[]

  // Set only for documents uploaded specifically while working an appeal.
  // Ordinary claim documents remain reusable evidence without an appeal owner.
  appealCaseId String?
  appealCase   DenialCase? @relation("AppealUploadedDocuments", fields: [appealCaseId], references: [id], onDelete: SetNull)

  @@unique([claimId, fileHash])
  @@index([appealCaseId])
}

model CodingSuggestion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  system        CodingSystem
  suggestedCode String
  confidence    Int?
  evidenceText  String?

  status          CodingSuggestionStatus @default(PENDING)
  finalCode       String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User? @relation("CodingSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([documentId, system, suggestedCode])
  @@index([claimId, status])
  @@index([documentId, status])
}


model PayerTransaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  transactionId String
  mode          String @default("SIMULATED")
  payerCode     String
  transactionType String
  status        String
  latencyMs     Int?
  requestHash   String?
  requestPayload Json?
  responsePayload Json?

  @@unique([transactionId, claimId])
  @@unique([claimId, transactionType, requestHash])
  @@index([claimId, createdAt])
  @@index([payerCode])
  @@index([transactionType])
}

model Check {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  score  Int
  issues Json

  // Readiness checks are historical. Claim/document/journey changes mark the
  // latest result stale instead of deleting it, so users can see progress.
  isStale     Boolean   @default(false)
  staleAt     DateTime?
  staleReason String?

  // Organization ruleset revision used for this readiness result.
  rulesetRevision Int @default(1)
  rulesetFingerprint String?

  // ✅ Rejection Risk Prediction (AI)
  riskScore   Float?
  riskLevel   String? // LOW | MED | HIGH
  riskFactors Json? // ["Missing discharge summary", ...]
  aiSummary   Json? // any extra AI outputs if you want later
}


model CodeSetRelease {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  system        String
  version       String
  source        String
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  authoritative Boolean  @default(false)

  definitions CodeDefinition[]

  @@unique([system, version])
  @@index([system, effectiveFrom, effectiveTo])
}

model CodeDefinition {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  releaseId   String
  release     CodeSetRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  code        String
  description String?
  billable    Boolean  @default(true)
  activeFrom  DateTime? @db.Date
  activeTo    DateTime? @db.Date

  @@unique([releaseId, code])
  @@index([code])
  @@index([releaseId, activeFrom, activeTo])
}

model RuleRecommendation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fingerprint     String
  status          String @default("PENDING")
  denialCategory  String
  carcCode        String?
  rarcCode        String?
  payerName       String?
  payerEdiId      String?

  occurrenceCount Int
  revenueAtRisk   Decimal @default(0) @db.Decimal(14,2)
  firstObservedAt DateTime?
  lastObservedAt  DateTime?

  proposedRule    Json?
  rationale       String
  approvedRuleId  String?
  reviewedByUserId String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, denialCategory])
}

model Rule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  category    String @default("CLAIM")
  severity    String @default("WARN")
  enabled     Boolean @default(true)

  // SYSTEM rules are implemented by deterministic server-side evaluators.
  // CUSTOM rules use the controlled JSON definition interpreted by configurableRuleEngine.
  ruleType      String @default("CUSTOM")
  systemManaged Boolean @default(false)
  mandatory     Boolean @default(false)

  // Organization rules apply to every claim. PAYER rules additionally require
  // a matching payer name and/or payer EDI identifier.
  scope      String @default("ORGANIZATION")
  payerName  String?
  payerEdiId String?

  // Safe condition document:
  // { field, operator, value?, appliesWhen?: { field, operator, value? } }
  definition Json?

  source        String @default("ORGANIZATION")
  version       String @default("1.0")
  revision      Int @default(1)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  deletedAt     DateTime?

  versions RuleVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([organizationId, category])
  @@index([organizationId, scope, payerEdiId])
}

model RuleVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ruleId String
  rule   Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  revision      Int
  versionLabel  String
  changeType    String
  changedByUserId String?
  snapshot      Json

  @@unique([ruleId, revision])
  @@index([organizationId, createdAt])
  @@index([ruleId, createdAt])
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  displayName  String?
  status       String @default("ACTIVE")
  teamId       String?
  team         Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokens RefreshToken[]
  createdClaims Claim[] @relation("ClaimCreatedBy")
  assignedClaims Claim[] @relation("ClaimAssignedTo")
  auditEvents AuditEvent[] @relation("AuditActor")
  reviewedCodingSuggestions CodingSuggestion[] @relation("CodingSuggestionReviewer")
  savedQueues SavedQueue[]
  comments ClaimComment[] @relation("ClaimCommentAuthor")
  assignedClinicalRequests ClinicalRequest[] @relation("ClinicalRequestAssignee")
  requestedClinicalRequests ClinicalRequest[] @relation("ClinicalRequestRequester")
  notifications Notification[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals ApprovalRequest[] @relation("ApprovalReviewer")
  ownershipChanges ClaimOwnershipHistory[] @relation("OwnershipChangedBy")

  @@index([organizationId])
  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean @default(true)

  users User[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model SavedQueue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId    String
  ownerUser      User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name           String
  filters        Json
  sharedWithTeam Boolean @default(false)

  @@unique([ownerUserId, name])
  @@index([organizationId, ownerUserId])
}

model ClaimComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorUser     User @relation("ClaimCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  body           String
  mentionUserIds String[] @default([])

  @@index([organizationId, claimId, createdAt])
}

model ClinicalRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  requestedByUserId String
  requestedByUser User @relation("ClinicalRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedToUser User? @relation("ClinicalRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  requestType    String
  requestText    String
  status         String @default("OPEN")
  dueAt          DateTime?
  responseText   String?
  resolvedAt     DateTime?

  @@index([organizationId, status, dueAt])
  @@index([assignedToUserId, status])
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String
  title          String
  message        String
  claimId        String?
  readAt         DateTime?

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model ApprovalRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedByUser User @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedByUserId String?
  reviewedByUser User? @relation("ApprovalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  requestType    String
  amount         Decimal? @db.Decimal(14,2)
  reason         String
  status         String @default("PENDING")
  decisionReason String?
  reviewedAt     DateTime?

  @@index([organizationId, status, createdAt])
  @@index([claimId, status])
}

model ClaimOwnershipHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimId        String
  claim          Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  changedByUserId String?
  changedByUser User? @relation("OwnershipChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  previousAssigneeUserId String?
  newAssigneeUserId      String?
  previousTeam           String?
  newTeam                String?
  previousPriority       String?
  newPriority            String?
  reason                 String?

  @@index([organizationId, claimId, createdAt])
}

model AuthRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  resetAt         DateTime
  updatedAt       DateTime @updatedAt

  @@index([resetAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  sessionId  String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([sessionId])
  @@index([userId, sessionId])
}


model DenialCase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Payer/remittance source data. CARC/RARC fields map to standard adjustment/remark concepts.
  source          DenialCaseSource @default(MANUAL)
  status          DenialCaseStatus @default(OPEN)
  denialCategory  String?
  groupCode       String?
  carcCode        String?
  rarcCode        String?
  reasonText      String?
  denialDate      DateTime?
  sourceTransactionId String?
  payerEvidence       Json?

  correctable     Boolean?
  appealEligible  Boolean?
  appealDeadline  DateTime?
  revenueAtRisk   Decimal? @db.Decimal(14,2)
  recoveredAmount Decimal? @db.Decimal(14,2)

  // Recovery assessment remains system-derived by default. An authorized
  // override requires a reason and is recorded here plus in AuditEvent.
  assessmentOverrideReason String?
  assessmentOverriddenAt   DateTime?

  // Human-reviewed appeal workspace fields. Evidence IDs refer only to
  // documents already attached to the same claim.
  appealRationale          String?
  appealEvidenceDocumentIds String[] @default([])
  appealPreparedAt         DateTime?
  appealSubmittedAt        DateTime?
  appealSubmissionReference String?
  appealSubmissionChannel   String?
  appealExternalSubmittedAt DateTime?

  // Documents newly uploaded from this appeal workspace. Existing claim
  // documents selected as evidence continue to be tracked by ID above.
  appealUploadedDocuments Document[] @relation("AppealUploadedDocuments")

  recommendedAction String?
  requiredDocuments Json?

  // Grounded AI/LLM output. Provider/model metadata makes AI use auditable.
  aiExplanation String?
  aiConfidence  Int?
  aiProvider    String?
  aiModel       String?
  aiAnalyzedAt  DateTime?
  aiInputVersion String? @default("denial-v1")

  @@index([claimId])
  @@index([sourceTransactionId])
  @@index([status])
  @@index([denialCategory])
}

model PayerContract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  payerName     String?
  payerEdiId    String?
  version       String
  status        String @default("ACTIVE")
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  sourceType    String @default("MANUAL")
  notes         String?

  feeScheduleLines FeeScheduleLine[]
  underpaymentCases UnderpaymentCase[]

  @@unique([organizationId, name, version])
  @@index([organizationId, payerEdiId, status])
  @@index([organizationId, payerName, status])
  @@index([effectiveFrom, effectiveTo])
}

model FeeScheduleLine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractId String
  contract   PayerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  cptHcpcsCode String
  modifier     String?
  placeOfService String?
  unitRate      Decimal @db.Decimal(14,2)
  description   String?

  @@index([contractId, cptHcpcsCode])
  @@index([cptHcpcsCode])
}

model UnderpaymentCase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimId String @unique
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  status UnderpaymentCaseStatus @default(OPEN)
  expectedPayerPayment Decimal @db.Decimal(14,2)
  actualPaidAmount     Decimal @db.Decimal(14,2)
  varianceAmount       Decimal @db.Decimal(14,2)
  recoveredAmount      Decimal @default(0) @db.Decimal(14,2)

  expectedPaymentSource String? @default("REMITTANCE_EXPECTATION")
  contractId             String?
  contract               PayerContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  calculationSnapshot    Json?

  reasonCategory     String? @default("PAYER_PAYMENT_BELOW_EXPECTED")
  sourceTransactionId String?
  notes              String?
  detectedAt         DateTime @default(now())
  resolvedAt         DateTime?

  @@index([status])
  @@index([detectedAt])
  @@index([contractId])
}

model IntegrationConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  kind        String
  provider    String
  environment String @default("SANDBOX")
  status      String @default("ACTIVE")

  lastHealthyAt DateTime?
  lastErrorAt   DateTime?
  lastErrorCode String?

  externalIdentities ClaimExternalIdentity[]
  events             IntegrationEvent[]

  @@unique([organizationId, name])
  @@index([organizationId, kind, status])
}

model ClaimExternalIdentity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  externalClaimId String
  recordType      String @default("CLAIM")

  @@unique([connectionId, externalClaimId])
  @@index([organizationId, claimId])
  @@index([claimId])
}

model IntegrationEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  claimId String?
  claim   Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  externalEventId String
  eventType       String
  direction       String
  status          String
  sourceStatus    String?
  correlationId   String?
  payloadHash     String
  occurredAt      DateTime?
  processedAt     DateTime?
  errorCode       String?
  metadata        Json?

  @@unique([connectionId, externalEventId])
  @@index([organizationId, createdAt])
  @@index([claimId, createdAt])
  @@index([connectionId, status, createdAt])
}

model PriorAuthCase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  status            String @default("DRAFT")
  requirementSource String?
  payerReference    String?
  submissionChannel String?
  submittedAt       DateTime?
  responseDueAt     DateTime?
  decisionAt        DateTime?
  authorizationNo   String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?

  requiredDocuments       Json?
  missingDocuments        Json?
  additionalInfoRequests  Json?
  notes                   String?

  @@index([organizationId, status])
  @@index([responseDueAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  claimId String?
  claim   Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  outcome     String
  metadata    Json?

  // Request/security context. These fields intentionally contain no claim PHI.
  ipAddress   String?
  userAgent   String?
  httpMethod  String?
  httpPath    String?
  requestId   String?
  statusCode  Int?

  @@index([organizationId, createdAt])
  @@index([claimId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([requestId])
}
