generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdmissionType {
  PLANNED
  EMERGENCY
}

enum ClaimType {
  CASHLESS
  REIMBURSEMENT
}

enum ClaimStage {
  INITIAL
  ENHANCEMENT
  FINAL
}

enum RoomCategory {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
}

enum UserRole {
  ADMIN
  CASHIER
  RECEPTIONIST
}

model Claim {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  patientName String
  payerName   String
  policyNo    String?
  amount      Int?
  status      String  @default("DRAFT")

  patientAge    Int?
  patientGender Gender?
  patientDob    DateTime?
  uhid          String?
  patientMobile String?
  memberId      String?

  hospitalName    String?
  hospitalAddress String?
  hospitalRegNo   String?
  doctorName      String?
  doctorRegNo     String?

  admissionDate DateTime?
  dischargeDate DateTime?
  admissionType AdmissionType?
  diagnosisText String?
  icd10Codes    String[]       @default([])
  procedureText String?
  procedureDate DateTime?
  dateOfService DateTime?

  tpaName           String?
  policyStartDate   DateTime?
  policyEndDate     DateTime?
  productType       String?
  sumInsured        Int?
  balanceSumInsured Int?

  claimType         ClaimType     @default(REIMBURSEMENT)
  claimStage        ClaimStage    @default(INITIAL)
  totalBilledAmount Int?
  approvedAmount    Int?
  deductionAmount   Int?
  copayAmount       Int?
  roomCategory      RoomCategory?
  icuDays           Int?

  tpaReferenceNo      String?
  insurerClaimNo      String?
  authorizationNo     String?
  claimSubmissionDate DateTime?

  // Revenue-cycle journey: eligibility -> prior auth -> claim -> status -> remittance.
  // These fields are deliberately explicit so each stage can be audited and gated.
  eligibilityStatus       String   @default("NOT_CHECKED")
  eligibilityCheckedAt    DateTime?
  coverageStatus          String?
  deductibleRemaining     Int?
  coinsurancePct          Int?
  networkStatus           String?

  priorAuthRequired       Boolean?
  priorAuthStatus         String   @default("NOT_CHECKED")
  priorAuthCheckedAt      DateTime?
  priorAuthExpiry         DateTime?

  payerClaimStatus        String?
  claimStatusCheckedAt    DateTime?

  remittanceStatus        String   @default("NOT_AVAILABLE")
  remittanceReceivedAt    DateTime?
  allowedAmount           Int?
  patientResponsibility   Int?
  paidAmount              Int?
  paymentReference        String?

  // Fields currently supported by uploaded documents. This lets document
  // deletion recompute/clear only document-derived data without wiping
  // values a user entered manually.
  documentDerivedFields String[] @default([])

  documents   Document[]
  checks      Check[]
  denialCases DenialCase[]
  auditEvents AuditEvent[]
}

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  type      String
  fileName  String
  mimeType  String
  sizeBytes Int
  path      String

  fileHash    String? @unique
  rawText     String?
  ocrProvider String?

  isMandatory Boolean @default(false)
  verified    Boolean @default(false)

  // ✅ Document Intelligence (AI)
  suggestedType String?
  confidence    Int? // 0..100
  extracted     Json? // { patientName?, amount?, dates?, ... }
  status        String  @default("PENDING") // PENDING, PROCESSED, FAILED
}

model Check {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  score  Int
  issues Json

  // ✅ Rejection Risk Prediction (AI)
  riskScore   Float?
  riskLevel   String? // LOW | MED | HIGH
  riskFactors Json? // ["Missing discharge summary", ...]
  aiSummary   Json? // any extra AI outputs if you want later
}

model Rule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  code     String  @unique
  name     String
  severity String  @default("WARN")
  enabled  Boolean @default(true)
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)

  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([token])
  @@index([userId])
}


model DenialCase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimId String
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Payer/remittance source data. CARC/RARC fields map to standard adjustment/remark concepts.
  source          String   @default("MANUAL")
  status          String   @default("OPEN")
  denialCategory  String?
  groupCode       String?
  carcCode        String?
  rarcCode        String?
  reasonText      String?
  denialDate      DateTime?

  correctable     Boolean?
  appealEligible  Boolean?
  appealDeadline  DateTime?
  revenueAtRisk   Int?
  recoveredAmount Int?

  recommendedAction String?
  requiredDocuments Json?

  // Grounded AI/LLM output. Provider/model metadata makes AI use auditable.
  aiExplanation String?
  aiConfidence  Int?
  aiProvider    String?
  aiModel       String?
  aiAnalyzedAt  DateTime?
  aiInputVersion String? @default("denial-v1")

  @@index([claimId])
  @@index([status])
  @@index([denialCategory])
}

model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  claimId String?
  claim   Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  outcome     String
  metadata    Json?

  @@index([claimId])
  @@index([actorUserId])
  @@index([createdAt])
}
