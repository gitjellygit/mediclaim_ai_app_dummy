    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "uat:approval:seed": "APPROVAL_UAT_ACTION=seed playwright test --config=playwright.uat.config.js --headed",
    "uat:approval:cleanup": "APPROVAL_UAT_ACTION=cleanup playwright test --config=playwright.uat.config.js",
    "test:postmerge:visible": "PW_SLOW_MO=700 playwright test tests/claim-work-queue-actions.e2e.spec.js tests/payer-journey.e2e.spec.js tests/payer-connector.e2e.spec.js tests/us-readiness-rules.e2e.spec.js tests/document-claim-autofill.e2e.spec.js --headed",
