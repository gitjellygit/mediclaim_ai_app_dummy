{
  "name": "claim-ai-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:medical": "playwright test tests/medical-consistency.e2e.spec.js --headed",
    "test:medical:fast": "playwright test tests/medical-consistency.e2e.spec.js",
    "test:medical:report": "playwright show-report",
    "test:payer": "playwright test tests/payer-journey.e2e.spec.js --headed",
    "test:payer:fast": "playwright test tests/payer-journey.e2e.spec.js",
