    "test:e2e:fast": "playwright test",
    "test:us": "playwright test tests/us-localization.e2e.spec.js --headed",
    "test:us:fast": "playwright test tests/us-localization.e2e.spec.js",
    "test:us:advanced": "playwright test tests/us-advanced-regression.e2e.spec.js --headed",
    "test:us:advanced:fast": "playwright test tests/us-advanced-regression.e2e.spec.js",
    "test:us:all": "playwright test tests/us-localization.e2e.spec.js tests/us-advanced-regression.e2e.spec.js --headed",
    "test:us:all:fast": "playwright test tests/us-localization.e2e.spec.js tests/us-advanced-regression.e2e.spec.js",
    "test:us:u3": "playwright test tests/us-claim-data-model.e2e.spec.js --headed",
    "test:us:u3:fast": "playwright test tests/us-claim-data-model.e2e.spec.js",
    "test:us:u4": "playwright test tests/us-claim-form.e2e.spec.js --headed",
