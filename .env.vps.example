# PRISM Hostinger VPS demo/UAT environment.
# Synthetic data only. Do not put real PHI into this deployment.

NODE_ENV=demo

POSTGRES_USER=prism_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=prism

JWT_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Public URLs
VITE_API_URL=https://api-prism.jellygit.com
CORS_ORIGIN=https://prism.jellygit.com

# Refresh cookie crosses from the browser frontend to the API subdomain.
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=true
TRUST_PROXY=true

# Demo/UAT document storage only. Production PHI deployment must use S3.
DOCUMENT_STORAGE_BACKEND=local
UPLOAD_DIR=/app/backend/uploads
AWS_REGION=us-east-1
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_KMS_KEY_ID=

# Keep PHI / external payer production integrations disabled.
HIPAA_BAA_CONFIRMED=false
PAYER_CONNECTOR_MODE=LOCAL
PAYER_CONNECTOR_ID=
STEDI_PRODUCTION_PHI_CONFIRMED=false
STEDI_PRODUCTION_SUBMISSION_ENABLED=false
STEDI_PRODUCTION_837I_ENABLED=false
STEDI_PRODUCTION_ERA_TENANT_ISOLATION_CONFIRMED=false
E2E_TEST_MODE=false

# Optional sandbox/demo integrations.
ATHENAHEALTH_SANDBOX_MOCK=true

# Create demo users only when you intentionally run the seed command.
DEV_ADMIN_PASSWORD=CHANGE_ME
DEV_CASHIER_PASSWORD=CHANGE_ME
DEV_RECEPTION_PASSWORD=CHANGE_ME
